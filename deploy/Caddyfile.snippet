# Dare.Arenas web pages: paste inside the subspacefoundation.com { ... } site block.
#
# - handle_path strips /arena; the plugin serves both /x and /arena/x and always links to /arena/...
# - header_up Host is REQUIRED: the plugin's HttpListener is bound to 127.0.0.1:8088 and matches
#   prefixes on the Host header, so the client's "Host: subspacefoundation.com" would get 404.
# - /arena (no slash) is not matched by /arena/*; redirect it so relative links resolve.
redir /arena /arena/ 308
handle_path /arena/* {
	reverse_proxy 127.0.0.1:8088 {
		header_up Host {upstream_hostport}
	}
}

# Foundation account pages (same listener). The /account prefix is KEPT (handle, not handle_path):
# the plugin routes every path starting with /account to the account pages, everything else to the
# arena pages. Caddy sets X-Forwarded-For to the client address; the plugin trusts it only on
# loopback connections (per-IP send/sign-up limits). The session cookie dare_session is Path=/,
# shared by /account and /arena.
redir /account /account/ 308
handle /account/* {
	reverse_proxy 127.0.0.1:8088 {
		header_up Host {upstream_hostport}
	}
}

# Public pilot profiles (same listener): /pilot/<name>. The /pilot prefix is KEPT (handle, not
# handle_path). The page and its data come from the plugin; there is no page at /pilot itself.
handle /pilot/* {
	reverse_proxy 127.0.0.1:8088 {
		header_up Host {upstream_hostport}
	}
}
