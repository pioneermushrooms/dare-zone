; by the Dare.Arenas module; never global. The [arenaowner] section in groupdef.conf also
; includes groupdef.dir/default and groupdef.dir/arenacaps.

; Continuum's in-game settings editor, for the owner's own arena
cmd_quickfix

; owner commands (Dare.Arenas)
cmd_arenaset
cmd_arenaget
cmd_comod
; map upload is ?arenamap, NOT ?putmap: never grant cmd_putmap to owners. The core AdminCommand
; module registers ?putmap too; it writes maps/uploads/ with no size limit and would run as well.
cmd_arenamap
cmd_putlvz
cmd_weblogin
