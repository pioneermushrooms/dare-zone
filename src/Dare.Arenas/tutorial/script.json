    {"id": "shields", "act": 2, "engineOff": true, "lines": ["I've given you Shields. Soaks hits, until it runs out.", "Check your item icons. Repel's in there too."], "check": {"kind": "none"}, "reveal": ["Items"], "grant": ["Shield", "Repel"], "pauseSeconds": 4, "cast": [{"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}, {"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}, {"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}, {"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}, {"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}], "leanCast": [{"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}]},
    {"id": "repel", "act": 2, "engineOff": true, "lines": ["Now {repel}: push 'em back!"], "check": {"kind": "weapon", "weapon": "repel"}, "cast": [{"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}, {"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}, {"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}, {"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}, {"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}], "leanCast": [{"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}]},
    {"id": "shootswarm", "act": 2, "engineOff": true, "lines": ["Now shoot them down with {gun}. Tap, don't hold."], "check": {"kind": "kills", "count": 2, "orAfterSeconds": 20}, "cast": [{"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}, {"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}, {"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}, {"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}, {"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}], "leanCast": [{"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}]},
    {"id": "super", "act": 2, "engineOff": true, "lines": ["Ha, this'll take forever. Here, have a Super. Cheater's tool.", "Now finish the rest of them."], "check": {"kind": "killall"}, "grant": ["Super", "Gun"], "cast": [{"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}, {"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}, {"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}, {"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}, {"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}], "leanCast": [{"role": "swarm", "seat": "in", "script": "ship 2\nbehaviour swarm\nrange 12"}]},
