  "steps": [
    {"id": "hello", "act": 1, "lines": ["Name's Vex. Call sign: Ace-in-Waiting. Fresh pilot, huh?", "Stick with me. I'll make you almost as good as me."], "check": {"kind": "none"}, "pauseSeconds": 0},
    {"id": "turn", "act": 1, "lines": ["Turn with Left and Right. Spin all the way round, I'll wait."], "check": {"kind": "rotate"}},
    {"id": "fly", "act": 1, "lines": ["Up thrusts, Down reverses. Fly to the beacon. Try not to hit a wall."], "check": {"kind": "reach", "x": 460, "y": 462, "radius": 4}},
    {"id": "energy", "act": 1, "lines": ["Bar up top is your life AND your ammo. Spend it wisely."], "check": {"kind": "none"}, "reveal": ["Energy"], "pauseSeconds": 4},
