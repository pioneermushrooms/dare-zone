<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Dare.Arenas</AssemblyName>
    <RootNamespace>Dare.Arenas</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <OutDir>$(MSBuildThisFileDirectory)../../out/modules/Dare.Arenas/</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../vendor/SubspaceServer/src/Core/Core.csproj">
      <Private>false</Private>
      <ExcludeAssets>all</ExcludeAssets>
    </ProjectReference>
    <!-- login packet / string helpers for FoundationAuth; shipped by the server (no copy in the plugin folder) -->
    <ProjectReference Include="../../vendor/SubspaceServer/src/Packets/Packets.csproj">
      <Private>false</Private>
      <ExcludeAssets>all</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="../../vendor/SubspaceServer/src/Utilities/Utilities.csproj">
      <Private>false</Private>
      <ExcludeAssets>all</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="../Dare.Arenas.Core/Dare.Arenas.Core.csproj" />
  </ItemGroup>

  <!-- Web pages, served from the assembly (no files to deploy beside the dll). -->
  <ItemGroup>
    <EmbeddedResource Include="Web/wwwroot/*" LogicalName="wwwroot/%(Filename)%(Extension)" />
    <!-- Shared with the public site (site/), one source: the top bar's styles and the arena chat panel. The plugin serves
         them as /arena/… and /account/…, so its pages always get the copy they were built with. -->
    <EmbeddedResource Include="../../site/header.css;../../site/header.js;../../site/chat.css;../../site/chat.js" LogicalName="wwwroot/%(Filename)%(Extension)" />
    <!-- Stock game graphics, shown as an arena's current graphics until it replaces them. -->
    <EmbeddedResource Include="Web/gfx/*.bm2" LogicalName="gfx/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Web/wwwroot/gamemode-art/*.bmp" LogicalName="gamemode-art/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The voice-menu phrase table (single source: voice/phrases.json). -->
  <ItemGroup>
    <EmbeddedResource Include="../../voice/phrases.json" LogicalName="voice.phrases.json" />
  </ItemGroup>

  <!-- The in-game tutorial script (steps, mentor lines, checks, bot casts). -->
  <ItemGroup>
    <EmbeddedResource Include="tutorial/script.json" LogicalName="tutorial.script.json" />
  </ItemGroup>

  <!--
    The server ships Microsoft.Data.Sqlite 9.0.3 / SQLitePCLRaw (managed + native) in its bin/.
    Exclude their runtime/native assets so the plugin folder carries no copy and the server's are used.
    SQLitePCLRaw is 2.1.14: 2.1.10's native SQLite has a known high-severity flaw (GHSA-2m69-gcr7-jv3q);
    deploy/remote-install.sh puts 2.1.14's native libe_sqlite3.so in the server's bin/ (same C API).
    Versions must match what Dare.Arenas.Core references.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.3" ExcludeAssets="runtime;native" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.3" ExcludeAssets="runtime;native" PrivateAssets="all" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" ExcludeAssets="runtime;native" PrivateAssets="all" />
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.14" ExcludeAssets="runtime;native" PrivateAssets="all" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" ExcludeAssets="runtime;native" PrivateAssets="all" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.14" ExcludeAssets="runtime;native" PrivateAssets="all" />
  </ItemGroup>

</Project>
